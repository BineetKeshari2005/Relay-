# Relay Environment Configuration (Phase 2)
# Copy this file to .env before starting the server

ENVIRONMENT=development
LOG_LEVEL=INFO

# Moss Retrieval Credentials
# Get these from your Moss project settings
MOSS_PROJECT_ID=your_moss_project_id_here
MOSS_PROJECT_KEY=your_moss_project_key_here
MOSS_BASE_URL=https://api.moss.sh/v1
MOSS_INDEX_NAME=relay-hvac
MOSS_HYBRID_ALPHA=0.8

# LLM Provider Configuration
# Supported options: mock, gemini, openai
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
